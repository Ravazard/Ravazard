# Lab-only credentials. These containers are only reachable from your own Mac.
# If you change MONITOR/APP/ORC passwords, change them in conf/proxysql.cnf and
# conf/orchestrator.conf.json too.
ROOT_PASSWORD=rootpass
REPL_PASSWORD=replpass
ORC_PASSWORD=orcpass
MONITOR_PASSWORD=monitorpass
APP_PASSWORD=apppass
CLONE_PASSWORD=clonepass

PROXYSQL_TAG=latest          # pin a version (e.g. 2.7.1) if latest misbehaves
ORCHESTRATOR_TAG=latest
